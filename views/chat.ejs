<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Chat</title>
  <link rel="stylesheet" href="chat.css" />
</head>
<body>
  <style>
    * {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
  background-color: #f4f6f9;
  height: 100vh;
  display: flex;
  justify-content: center;
  align-items: center;
}

.chat-form {
  width: 100%;
  max-width: 500px;
}

.chat-container {
  display: flex;
  flex-direction: column;
  height: 600px;
  background-color: #ffffff;
  border-radius: 12px;
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.1);
  overflow: hidden;
}

.chat-header {
  background-color: #4a90e2;
  color: white;
  padding: 16px;
  font-size: 18px;
  text-align: center;
  font-weight: bold;
}

.chat-window,
.chat-messages {
  flex: 1;
  overflow-y: auto;
  padding: 16px;
  display: flex;
  flex-direction: column;
  gap: 10px;
}

/* Common message style */
.message {
  max-width: 75%;
  padding: 10px 15px;
  border-radius: 16px;
  font-size: 15px;
  line-height: 1.4;
}

/* System messages (left) */
.message.system {
  align-self: flex-start;
  background-color: #e5e5ea;
  color: #000;
}

/* User messages (right) */
.message.user {
  align-self: flex-end;
  background-color: #dcf8c6;
  color: #000;
}

.chat-input-area {
  display: flex;
  padding: 12px 16px;
  border-top: 1px solid #ddd;
  background-color: #f9f9f9;
}

.chat-input-area input[type="text"] {
  flex: 1;
  padding: 10px 14px;
  font-size: 14px;
  border: 1px solid #ccc;
  border-radius: 20px;
  outline: none;
}

.send-button {
  margin-left: 10px;
  padding: 10px 20px;
  background-color: #4a90e2;
  color: white;
  border: none;
  border-radius: 20px;
  font-size: 14px;
  cursor: pointer;
  transition: background-color 0.3s ease;
}

.send-button:hover {
  background-color: #357abd;
}

  </style>
  <form class="chat-form" id="chat-form">
  <div class="chat-container">
    <div class="chat-header">Chat Interface</div>
    
    <div class="chat-window">
      <div class="message system">Hello! How can I help you?</div>
      <div class="message user">I have a question about your services.</div>
    </div>

    <div id="chat-messages" class="chat-messages">
      <!-- Messages will be dynamically added here -->
       
    </div>

    <div class="chat-input-area">
      <input type="text" id="message-input" placeholder="Type a message..." />
      <button class="send-button" id="send-button">Send</button>
    </div>
  </div>
  </form>

  <script src="https://cdn.socket.io/4.8.1/socket.io.min.js" integrity="sha384-mkQ3/7FUtcGyoppY6bz/PORYoGqOl7/aSUMn2ymDOJcapfS6PHqxhRTMh1RR0Q6+" crossorigin="anonymous"></script>

  <script>
      var socket = io()
      var message = document.getElementById("message-input")
      var form = document.getElementById("chat-form")
      var chatMessagesContainer = document.getElementById("chat-messages")
      message

      form.addEventListener("submit", (e)=> {
          e.preventDefault()
          if(message.value){
            const data = {
            message: message.value,
            senderId : 1,
            receiverId : 2
          }
            // socket ma emit garxu
            socket.emit("message", data)
            message.value = ""  // clear input field
            message.focus()  // focus on input field
          }
      })

      socket.on("broadCastMessage", (msg)=>{
        const paragraph = document.createElement("p")  // <p></p>
        paragraph.textContent = msg  // <p>Hello World</p>

        chatMessagesContainer.appendChild(paragraph) 
        chatMessagesContainer.scrollTop = chatMessagesContainer.scrollHeight  // scroll to bottom
        message.value = ""  // clear input field
        message.focus()  // focus on input field
      })
  </script>

</body>
</html>
